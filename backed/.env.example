# 复制为 .env 后填写；.env 已在 .gitignore 中，禁止提交
DEEPSEEK_API_KEY=sk-your-key
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# 可选：阿里云百炼（DashScope）rerank，不配则自动跳过重排序（降级为 RRF 排序）
# 公有云默认端点：https://dashscope.aliyuncs.com，模型 gte-rerank-v2
# 专属部署端点形如 https://ws-xxx.cn-beijing.maas.aliyuncs.com，base-url 不要带 /compatible-mode/v1
# QWEN_API_KEY=sk-your-dashscope-key
# RERANK_BASE_URL=https://dashscope.aliyuncs.com
# RERANK_MODEL=gte-rerank-v2

# 可选：PostgreSQL/pgvector 连接（默认与 docker-compose.yml 一致）
# PG_HOST=localhost
# PG_PORT=5432
# PG_DATABASE=ragdb
# PG_USER=rag
# PG_PASSWORD=rag

# 可选：Ollama Embedding
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_EMBEDDING_MODEL=bge-m3
